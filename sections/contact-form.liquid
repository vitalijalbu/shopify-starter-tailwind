<section class="py-16 bg-gray-50" aria-labelledby="contact-heading">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <!-- Colonna sinistra - Blocks content -->
      <div class="space-y-8">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'heading' %}
              <div class="block" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}
                  <h2 class="text-xl md:text-2xl font-bold text-gray-900 mb-4">
                    {{ block.settings.title }}
                  </h2>
                {% endif %}
              </div>
            {% when 'richtext' %}
              <div class="block prose prose-lg max-w-none" {{ block.shopify_attributes }}>
                {% if block.settings.content != blank %}
                  {{ block.settings.content }}
                {% endif %}
              </div>
          {% endcase %}
        {% endfor %}
      </div>

      <!-- Colonna destra - Contact form -->
      <div class="card">
      {% form 'contact', id: 'contact-form', class: 'space-y-6', novalidate: 'novalidate' %}
        {% if form.posted_successfully? %}
          <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6" role="alert">
            <div class="flex">
              <div class="shrink-0">
                {% render 'icon', icon: 'check-circle', class: 'size-5 text-green-400', aria_hidden: 'true' %}
              </div>
              <div class="ml-3">
                <p class="text-base font-medium text-green-800">Grazie! Il tuo messaggio è stato inviato con successo.</p>
              </div>
            </div>
          </div>
        {% endif %}

        {% if form.errors %}
          <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6" role="alert" aria-live="polite">
            <div class="flex">
              <div class="shrink-0">
                {% render 'icon', icon: 'exclamation-triangle', class: 'size-5 text-red-400', aria_hidden: 'true' %}
              </div>
              <div class="ml-3">
                <h3 class="text-base font-medium text-red-800">Si sono verificati alcuni errori:</h3>
                <ul class="mt-2 text-base text-red-700 list-disc list-inside">
                  {% for field in form.errors %}
                    <li>
                      {% assign field_name = field | capitalize %}
                      {{ field_name }}: {{ form.errors.messages[field] }}
                    </li>
                  {% endfor %}
                </ul>
              </div>
            </div>
          </div>
        {% endif %}

        <!-- Honeypot field per spam protection -->
        <div style="position: absolute; left: -9999px;" aria-hidden="true">
          <label for="contact-honeypot">Don't fill this out if you're human:</label>
          <input type="text" name="contact[honeypot]" id="contact-honeypot" tabindex="-1" autocomplete="off">
        </div>

        <!-- CSRF Token -->
        <input type="hidden" name="authenticity_token" value="{{ form.authenticity_token }}">

        <div>
          <label for="contact-name" class="block text-base font-medium text-gray-700 mb-2">
            Nome <span class="text-red-500" aria-label="Campo obbligatorio">*</span>
          </label>
          <input
            type="text"
            id="contact-name"
            name="contact[name]"
            value="{{ form.name | escape }}"
            class="form-input {% if form.errors contains 'name' %}border-red-300 focus:border-red-500 focus:ring-red-500{% endif %}"
            required
            aria-describedby="{% if form.errors contains 'name' %}name-error{% endif %}"
            autocomplete="name"
            maxlength="100"
            pattern="[A-Za-z\s]{2,100}"
          >
          {% if form.errors contains 'name' %}
            <p id="name-error" class="mt-1 text-base text-red-700" role="alert">
              {{ form.errors.messages.name }}
            </p>
          {% endif %}
        </div>

        <div>
          <label for="contact-email" class="block text-base font-medium text-gray-700 mb-2">
            Email <span class="text-red-500" aria-label="Campo obbligatorio">*</span>
          </label>
          <input
            type="email"
            id="contact-email"
            name="contact[email]"
            value="{{ form.email | escape }}"
            class="form-input {% if form.errors contains 'email' %}border-red-300 focus:border-red-500 focus:ring-red-500{% endif %}"
            required
            aria-describedby="{% if form.errors contains 'email' %}email-error{% endif %}"
            autocomplete="email"
            maxlength="254"
          >
          {% if form.errors contains 'email' %}
            <p id="email-error" class="mt-1 text-base text-red-700" role="alert">
              {{ form.errors.messages.email }}
            </p>
          {% endif %}
        </div>

        <div>
          <label for="contact-body" class="block text-base font-medium text-gray-700 mb-2"> Messaggio </label>
          <textarea
            id="contact-body"
            name="contact[body]"
            rows="6"
            class="form-input {% if form.errors contains 'body' %}border-red-300 focus:border-red-500 focus:ring-red-500{% endif %}"
            aria-describedby="{% if form.errors contains 'body' %}message-error{% endif %}"
            maxlength="1000"
          >{{ form.body | escape }}</textarea>
          {% if form.errors contains 'body' %}
            <p id="message-error" class="mt-1 text-base text-red-700" role="alert">
              {{ form.errors.messages.body }}
            </p>
          {% endif %}
        </div>

        <button
          type="submit"
          class="btn btn-secondary w-full uppercase"
          aria-describedby="submit-description"
        >
          Invia {% render 'icon', icon: 'arrow-top-right', aria_hidden: 'true' %}
        </button>

        <p id="submit-description" class="text-xs text-gray-500 text-center">
          I tuoi dati personali saranno trattati nel rispetto della privacy.
        </p>
      {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Form",
  "tag": "section",
  "class": "section-contact-form",
  "blocks": [
    {
      "type": "heading",
      "name": "Titolo",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titolo",
          "default": "Informazioni di contatto"
        }
      ]
    },
    {
      "type": "richtext",
      "name": "Testo",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Contenuto",
          "default": "<p>Inserisci qui le informazioni aggiuntive, orari, indirizzo o qualsiasi altro contenuto utile per i visitatori.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact Form",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "title": "Informazioni di contatto"
          }
        },
        {
          "type": "richtext",
          "settings": {
            "content": "<p><strong>Indirizzo:</strong><br>Via Example 123<br>00100 Roma, Italia</p><p><strong>Telefono:</strong><br>+39 06 1234567</p><p><strong>Email:</strong><br>info@skimofestival.com</p><p><strong>Orari:</strong><br>Lun-Ven: 9:00-18:00<br>Sab: 9:00-13:00</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<script>
  document.getElementById('contact-form').addEventListener('submit', function (e) {
    // Check honeypot
    const honeypot = document.getElementById('contact-honeypot');
    if (honeypot.value) {
      e.preventDefault();
      return false;
    }

    // Basic validation
    const name = document.getElementById('contact-name').value.trim();
    const email = document.getElementById('contact-email').value.trim();

    if (name.length < 2 || name.length > 100) {
      e.preventDefault();
      alert('Il nome deve essere tra 2 e 100 caratteri.');
      return false;
    }

    if (!email.match(/^[^\s@]+@[^\s@]+\.[^\s@]+$/)) {
      e.preventDefault();
      alert('Inserisci un indirizzo email valido.');
      return false;
    }
  });
</script>
