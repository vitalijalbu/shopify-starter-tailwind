<section class="container" aria-labelledby="account-heading">
  <div class="my-8 md:my-16 px-4 md:px-8">
    <header class="text-center mb-12 pb-8 border-b border-zinc-200">
      <h1 id="account-heading" class="text-4xl md:text-7xl font-bold mb-2">
        {% if customer.first_name != blank %}
          {{ 'customer.account.welcome' | t: first_name: customer.first_name }}
        {% else %}
          {{ 'customer.account.title' | t }}
        {% endif %}
      </h1>
      <p class="text-gray-600 mb-4">Sei ufficialmente iscritto a <span class="text-primary-400 font-semibold underline">Skimofestival 2026</span></p>
      <a
        href="{{ routes.account_logout_url }}"
        class="text-red-700 text-base hover:underline focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 rounded"
        aria-label="{{ 'customer.account.logout' | t }}"
      >
        {{ 'customer.account.logout' | t }}
      </a>
    </header>

    <!-- Tabs Navigation -->
    <div x-data="{ activeTab: 'orders' }" class="space-y-8">
      <!-- Tabs -->
      <div class="border-b border-zinc-200">
        <nav class="flex space-x-8" aria-label="Tabs">
          <button
            @click="activeTab = 'orders'"
            :class="activeTab === 'orders' ? 'border-primary-500 text-primary-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'"
            class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-base transition-colors"
          >
            Le mie attività
          </button>
        </nav>
      </div>

      <!-- Orders Tab -->
      <div x-show="activeTab === 'orders'" x-transition>
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-2xl font-semibold text-gray-900">Le mie attività</h2>
            <span class="text-base text-gray-500">{{ customer.orders_count }} attività totali</span>
          </div>

          {% if customer.orders_count > 0 %}
            <div class="space-y-4">
              {% paginate customer.orders by 10 %}
                {% for order in customer.orders %}
                  <div class="bg-white border border-zinc-200 rounded-lg p-6 hover:shadow-md transition-shadow">
                    <div class="flex flex-col gap-4">
                      <!-- Order Header -->
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                          <h3 class="text-lg font-semibold text-gray-900">Ordine {{ order.name }}</h3>
                        </div>
                        <span class="text-base font-semibold text-gray-900">{{ order.total_price | money }}</span>
                      </div>

                      <!-- Order Info -->
                      <div class="flex items-start justify-between gap-4">
                        <div class="text-base text-gray-600 space-y-1 flex-1">
                          <p>
                            <span class="font-medium text-gray-700">Data:</span>
                            {% assign mesi_it = 'Gennaio,Febbraio,Marzo,Aprile,Maggio,Giugno,Luglio,Agosto,Settembre,Ottobre,Novembre,Dicembre' | split: ',' %}
                            {% assign giorno = order.created_at | date: '%-d' %}
                            {% assign mese_num = order.created_at | date: '%-m' | minus: 1 %}
                            {% assign anno = order.created_at | date: '%Y' %}
                            {% assign mese_nome = mesi_it[mese_num] %}
                            {{ giorno }} {{ mese_nome }} {{ anno }}
                          </p>
                          <p>
                            <span class="font-medium text-gray-700">Articoli:</span> {{ order.item_count }}
                            {% if order.item_count == 1 %}articolo{% else %}articoli{% endif %}
                          </p>
                        </div>
                        <a href="{{ order.customer_url }}" class="btn btn-outline btn-sm shrink-0">
                          Vedi dettagli
                        </a>
                      </div>

                      <!-- Order Items Preview -->
                      {% if order.line_items.size > 0 %}
                        <div class="pt-4 border-t border-zinc-200">
                          <div class="flex items-center gap-2">
                            {% for line_item in order.line_items limit: 4 %}
                              <div class="shrink-0 w-20">
                                {% if line_item.image %}
                                  <img
                                    src="{{ line_item.image | image_url: width: 80 }}"
                                    alt="{{ line_item.title }}"
                                    class="size-20 object-cover rounded-xl mb-2"
                                    width="80"
                                    height="80"
                                  >
                                {% endif %}
                                </div>
                                <div class="text-gray-600">
                                  <p class="font-medium truncate" title="{{ line_item.product.title }}">
                                    {{ line_item.product.title }}
                                  </p>
                                  {% if line_item.variant.title != 'Default Title' %}
                                    <p class="text-gray-500 truncate" title="{{ line_item.variant.title }}">
                                      {{ line_item.variant.title }}
                                    </p>
                                  {% endif %}
                              </div>
                            {% endfor %}
                            {% if order.line_items.size > 4 %}
                              <div class="shrink-0 w-20 flex flex-col items-center justify-center">
                                <div class="size-20 bg-gray-100 rounded flex items-center justify-center text-xs text-gray-600 mb-2">
                                  +{{ order.line_items.size | minus: 4 }}
                                </div>
                                <div class="text-xs text-gray-500 text-center">
                                  Altri prodotti
                                </div>
                              </div>
                            {% endif %}
                          </div>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                {% endfor %}

                {% if paginate.pages > 1 %}
                  <div class="flex items-center justify-center gap-2 mt-8">
                    {% if paginate.previous %}
                      <a href="{{ paginate.previous.url }}" class="btn btn-outline btn-sm"> Precedente </a>
                    {% endif %}

                    <span class="text-base text-gray-600">
                      Pagina {{ paginate.current_page }} di {{ paginate.pages }}
                    </span>

                    {% if paginate.next %}
                      <a href="{{ paginate.next.url }}" class="btn btn-outline btn-sm"> Successiva </a>
                    {% endif %}
                  </div>
                {% endif %}
              {% endpaginate %}
            </div>
          {% else %}
            {% render 'empty-state' title: 'Nessun evento in programma' %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Account",
  "settings": []
}
{% endschema %}
