{% comment %}
  Customer Reset Password Section - Minimal
{% endcomment %}

<div class="container my-16">
  <div class="max-w-xl m-auto">
    <h1 class="text-center mb-8 text-3xl md:text-4xl font-bold text-gray-900">
      {{ 'customer.reset_password.title' | t }}
    </h1>

    <div x-data="{ loading: false }">
      {%- form 'reset_customer_password', novalidate: 'novalidate', class: 'flex flex-col gap-6' -%}
        <input type="hidden" x-ref="submitTrigger" @click="loading = true">
        <script>
          document.querySelector('form[action*="reset_customer_password"]')?.addEventListener('submit', function () {
            Alpine.evaluate(this.closest('[x-data]'), 'loading = true');
          });
        </script>

        {%- if form.posted_successfully? -%}
          <div class="p-4 bg-green-50 border border-green-200 rounded-lg text-green-700" role="status">
            <p class="text-base font-semibold mb-2">Password aggiornata con successo!</p>
            <p class="text-base">Ora puoi accedere con la tua nuova password.</p>
            <a href="{{ routes.account_login_url }}" class="inline-block mt-3 btn btn-primary btn-sm"> Vai al login </a>
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="p-4 bg-red-50 border border-red-200 rounded-lg text-red-700" role="alert">
            <h2 class="mb-2 text-base font-semibold">{{ 'customer.errors.title' | t }}</h2>
            <ul class="text-base list-disc pl-4">
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    {{ form.errors.translated_fields[field] | capitalize }}
                    {{ form.errors.messages[field] }}
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="w-full">
          <label for="password" class="block text-base font-medium text-gray-700 mb-1">
            Nuova password
            <span class="text-red-500">*</span>
          </label>
          <input
            type="password"
            id="password"
            name="customer[password]"
            class="form-input{% if form.errors contains 'password' %} border-red-300 focus:border-red-500 focus:ring-red-500{% endif %}"
            placeholder="Inserisci la nuova password"
            required
            minlength="6"
          >
          {% if form.errors contains 'password' %}
            <p class="mt-1 text-base text-red-700">
              {{ form.errors.translated_fields.password | capitalize }}
              {{ form.errors.messages.password }}.
            </p>
          {% endif %}
        </div>

        <div class="w-full">
          <label for="password_confirmation" class="block text-base font-medium text-gray-700 mb-1">
            Conferma nuova password
            <span class="text-red-500">*</span>
          </label>
          <input
            type="password"
            id="password_confirmation"
            name="customer[password_confirmation]"
            class="form-input{% if form.errors contains 'password_confirmation' %} border-red-300 focus:border-red-500 focus:ring-red-500{% endif %}"
            placeholder="Conferma la nuova password"
            required
            minlength="6"
          >
          {% if form.errors contains 'password_confirmation' %}
            <p class="mt-1 text-base text-red-700">
              {{ form.errors.translated_fields.password_confirmation | capitalize }}
              {{ form.errors.messages.password_confirmation }}.
            </p>
          {% endif %}
        </div>

        <div class="flex flex-col gap-4 mt-6">
          <button
            type="submit"
            class="btn btn-primary w-full"
            :disabled="loading"
            :class="{ 'opacity-75 cursor-not-allowed': loading }"
          >
            <span x-show="!loading">Aggiorna password</span>
            <span x-show="loading" class="flex items-center justify-center gap-2">
              <svg class="animate-spin size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Aggiornamento...
            </span>
          </button>

          <a
            href="{{ routes.account_login_url }}"
            class="text-center text-base text-gray-600 hover:text-gray-800 transition-colors no-underline hover:underline"
          >
            ← Torna al login
          </a>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Reset Password",
  "settings": []
}
{% endschema %}
