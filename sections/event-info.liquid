<section class="relative h-[476px] overflow-hidden">
  <!-- Immagine di sfondo -->
  {% if section.settings.background_image %}
    <img
      src="{{ section.settings.background_image | image_url: width: 1920 }}"
      alt="{{ section.settings.background_image.alt | escape }}"
      class="absolute inset-0 w-full h-full object-cover"
      width="1920"
      height="{{ 1920 | divided_by: section.settings.background_image.aspect_ratio | round }}"
    >
  {% else %}
    <div class="absolute inset-0 bg-linear-to-br from-gray-400 to-gray-600"></div>
  {% endif %}

  <!-- Overlay -->
  <div class="absolute inset-0 bg-black/30 z-10 "></div>

  <div class="container pt-20 h-full flex items-end relative z-20">
    <div class="w-full bottom-0">
      <div class="bg-dark backdrop-blur-sm text-white p-4 sm:p-6 lg:p-8 relative border-l-[20px] border-accent-teal">
        <!-- Mobile Layout -->
        <div class="flex flex-col gap-4 sm:hidden">
          <!-- Location e Date insieme su mobile -->
          <div class="flex gap-6">
            {% if section.settings.location != blank %}
              <div class="flex-1">
                <h3 class="text-xs font-medium tracking-wider mb-1 text-gray-300">Luogo</h3>
                <p class="text-base font-semibold">{{ section.settings.location }}</p>
              </div>
            {% endif %}

            {% if section.settings.date != blank %}
              <div class="flex-1">
                <h3 class="text-xs font-medium tracking-wider mb-1 text-gray-300">Data</h3>
                <p class="text-base font-semibold">{{ section.settings.date }}</p>
              </div>
            {% endif %}
          </div>

          {% if section.settings.description != blank %}
            <div>
              <p class="text-base leading-relaxed text-gray-100">
                {{ section.settings.description }}
              </p>
            </div>
          {% endif %}

          {% if section.settings.button_text != blank and section.settings.button_url != blank %}
            <div class="pt-2">
              <a
                href="{{ section.settings.button_url }}"
                class="inline-block bg-primary hover:bg-primary/90 text-white px-4 py-2 rounded-lg text-base font-medium transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-gray-900"
              >
                {{ section.settings.button_text }}
              </a>
            </div>
          {% endif %}
        </div>

        <!-- Desktop/Tablet Layout -->
        <div class="hidden sm:flex items-start lg:items-center gap-4 md:gap-6 lg:gap-8 flex-wrap lg:flex-nowrap">
          {% if section.settings.location != blank %}
            <div class="shrink-0">
              <h3 class="lg:text-lg font-semibold tracking-wider mb-1 text-white">Luogo:</h3>
              <p>{{ section.settings.location }}</p>
            </div>
          {% endif %}

          {% if section.settings.date != blank %}
            <div class="shrink-0">
              <h3 class="lg:text-lg font-semibold tracking-wider mb-1 text-white">Data:</h3>
              <p>{{ section.settings.date }}</p>
            </div>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="flex-1 min-w-0">
              <p class=" text-gray-100">
                {{ section.settings.description }}
              </p>
            </div>
          {% endif %}

          {% if section.settings.button_text != blank and section.settings.button_url != blank %}
            <div class="shrink-0">
              <a
                href="{{ section.settings.button_url }}"
                class="inline-block bg-primary hover:bg-primary/90 text-white px-4 lg:px-6 py-2 lg:py-3 rounded-lg text-base lg:text-base font-medium transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-gray-900"
              >
                {{ section.settings.button_text }}
              </a>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Destinazione Sciistica",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Immagine",
      "info": "Consigliata dimensione 1920x1080px"
    },
    {
      "type": "text",
      "id": "location",
      "label": "Luogo",
      "default": "Bormio, Alpi"
    },
    {
      "type": "text",
      "id": "date",
      "label": "Data",
      "default": "6-8 Marzo 2026"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descrizione",
      "default": "Scopri una località famosa per le sue piste da sci e le terme. La bellezza naturale e l'atmosfera indimenticabile."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Testo pulsante",
      "default": "Scopri di più"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Link pulsante"
    }
  ],
  "presets": [
    {
      "name": "Destinazione Sciistica"
    }
  ]
}
{% endschema %}
