<section class="py-16" id="faq-{{ section.id }}">
  <div class="container">
    <!-- Section Header -->
    <div class="mb-12">
      {% if section.settings.heading %}
        <h2 class="text-4xl md:text-7xl font-bold text-gray-900 mb-4" data-scroll="slide-rotate-up">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading %}
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <!-- FAQ Accordion -->
    {% liquid
      assign faqs = shop.metaobjects.faqs.values
    %}

    {% if faqs %}
      <div class="space-y-4" x-data="faqAccordion">
        {% for faq in faqs %}
          <div class="bg-white rounded-xl">
            <button
              type="button"
              @click="toggle({{ forloop.index0 }})"
              class="w-full px-[26px] py-8 text-left flex items-center justify-between cursor-pointer focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2 rounded-xl transition-colors"
              :aria-expanded="isOpen({{ forloop.index0 }})"
            >
              <span class="text-xl font-medium text-gray-900">{{ faq.question.value }}</span>
              <span
                class="ml-6 shrink-0 transition-all duration-200 rounded-full size-[34px] bg-gray-300"
                :class="isOpen({{ forloop.index0 }}) ? 'rotate-180 bg-dark!' : ''"
                :style="!isOpen({{ forloop.index0 }}) ? 'background: linear-gradient(85deg, rgba(37, 39, 44, 0.20) 1.59%, rgba(37, 39, 44, 0.00) 121.45%), #F1F2F9' : ''"
              >
                <span :class="isOpen({{ forloop.index0 }}) ? '[&>svg]:text-white' : '[&>svg]:text-gray-900'">
                  {% render 'icon', icon: 'chevron-down', class: 'transition-colors' %}
                </span>
              </span>
            </button>
            
            <div
              x-show="isOpen({{ forloop.index0 }})"
              x-transition:enter="transition ease-out duration-200"
              x-transition:enter-start="opacity-0 transform -translate-y-2"
              x-transition:enter-end="opacity-100 transform translate-y-0"
              x-transition:leave="transition ease-in duration-150"
              x-transition:leave-start="opacity-100 transform translate-y-0"
              x-transition:leave-end="opacity-0 transform -translate-y-2"
              class="px-[26px] pb-4"
            >
              <div class="text-gray-600 prose prose-sm max-w-none">
                {{ faq.answer | metafield_tag }}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="text-center py-12">
        <p class="text-gray-500">Nessuna domanda frequente disponibile al momento.</p>
      </div>
    {% endif %}
  </div>
</section>

<script>
function faqAccordion() {
  return {
    openItems: [],
    
    toggle(index) {
      if (this.isOpen(index)) {
        this.openItems = this.openItems.filter(i => i !== index);
      } else {
        this.openItems.push(index);
      }
    },
    
    isOpen(index) {
      return this.openItems.includes(index);
    }
  }
}
</script>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section-faq",
  "settings": [
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQ"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Contact CTA"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Hai altre domande? Contattaci"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "text",
      "id": "cta_button_text",
      "label": "CTA button text",
      "default": "Contattaci"
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}
