<section class="py-10 md:pt-[216px] overflow-x-hidden">
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'heading' %}
        <div class="container relative flex flex-col md:flex-row gap-6 md:justify-between md:items-center">
          <div class="mb-10 md:mb-26 max-w-3xl" {{ block.shopify_attributes }}>
            {% if block.settings.heading %}
              <h2 class="text-4xl md:text-7xl font-bold text-gray-900 mb-4 md:mb-0" data-scroll="slide-rotate-up">
                {{ block.settings.heading }}
              </h2>
            {% endif %}

            {% if block.settings.description %}
              <p class="text-lg text-gray-600 md:max-w-none max-w-3xl">
                {{ block.settings.description }}
              </p>
            {% endif %}
          </div>
          {% if block.settings.button_text != blank and block.settings.button_url != blank %}
            <a
              href="{{ block.settings.button_url }}"
              class="btn btn-{{ block.settings.button_style | default: 'primary' }} whitespace-nowrap"
              aria-label="{{ block.settings.button_text }}"
            >
              {{ block.settings.button_text }}
              {% if block.settings.show_arrow %}
                {% render 'icon', icon: 'arrow-top-right', class: 'ml-4 size-5', aria_hidden: 'true' %}
              {% endif %}
            </a>
          {% endif %}
        </div>

      {% when 'collection' %}
        {% liquid
          assign collection = collections[block.settings.collection]
          assign products_to_show = block.settings.products_to_show | default: 8
        %}

        {% if collection and collection.products.size > 0 %}
          <div class="mb-8" {{ block.shopify_attributes }}>
            {% if block.settings.show_collection_title %}
              <h3 class="text-4xl md:text-7xl font-bold text-gray-900 mb-6" data-scroll="slide-up">
                {{ collection.title }}
              </h3>
            {% endif %}

            <div class="featured-products-swiper-container overflow-hidden">
              <div class="flex gap-4 mb-6 justify-end px-4">
                <button class="btn-prev btn-icon-outline">
                  {% render 'icon', icon: 'arrow-left' %}
                </button>
                <button class="btn-next btn-icon-outline">
                  {% render 'icon', icon: 'arrow-right' %}
                </button>
              </div>
              <div id="featured-products-swiper" class="swiper product-carousel featured-products-swiper w-full mb-6">
                <div class="swiper-wrapper">
                  {% for product in collection.products limit: products_to_show %}
                    <div class="swiper-slide {% if forloop.first %}pl-4 xl:pl-8{% endif %}">
                      {% render 'card-experience',
                        product: product,
                        show_vendor: block.settings.show_vendor,
                        show_rating: block.settings.show_rating
                      %}
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>
            {% if block.settings.show_view_all and collection.products.size > products_to_show %}
              <div class="text-center mt-8">
                <a href="{{ collection.url }}" class="btn btn-outline"> Vedi tutti i prodotti </a>
              </div>
            {% endif %}
          </div>
        {% endif %}

      {% when 'product_list' %}
        {% if block.settings.product_list.size > 0 %}
          <div class="mb-8" {{ block.shopify_attributes }}>
            {% if block.settings.title %}
              <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-6">{{ block.settings.title }}</h3>
            {% endif %}

            <div class="grid grid-cols-2 md:grid-cols-{{ block.settings.columns | default: 4 }} gap-6">
              {% for product in block.settings.product_list %}
                {% render 'card-experience',
                  product: product,
                  show_vendor: block.settings.show_vendor,
                  show_rating: block.settings.show_rating
                %}
              {% endfor %}
            </div>
          </div>
        {% endif %}

      {% when 'button' %}
        <div class="text-center mb-8" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.button_url }}" class="btn btn-{{ block.settings.button_style }} btn-lg">
            {{ block.settings.button_text }}
          </a>
        </div>

      {% when 'spacer' %}
        <div class="py-{{ block.settings.height | default: 4 }}" {{ block.shopify_attributes }}></div>

      {% when 'divider' %}
        <div class="my-8" {{ block.shopify_attributes }}>
          <hr class="border-zinc-200">
        </div>

      {% when 'text' %}
        <div class="text-center mb-8 max-w-3xl mx-auto" {{ block.shopify_attributes }}>
          {% if block.settings.text %}
            <div class="prose prose-lg mx-auto">
              {{ block.settings.text }}
            </div>
          {% endif %}
        </div>

      {% when 'image_with_text' %}
        <div class="grid lg:grid-cols-2 gap-12 items-center mb-12" {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            <div class="{% if block.settings.layout == 'image_first' %}order-1{% else %}order-2{% endif %}">
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag: alt: block.settings.image.alt, class: 'w-full h-auto rounded-lg', width: '600', height: 600
                | divided_by: block.settings.image.aspect_ratio
                | round
              }}
            </div>
          {% endif %}

          <div class="{% if block.settings.layout == 'image_first' %}order-2{% else %}order-1{% endif %}">
            {% if block.settings.heading %}
              <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-4">
                {{ block.settings.heading }}
              </h3>
            {% endif %}

            {% if block.settings.text %}
              <div class="prose prose-lg text-gray-600 mb-6">
                {{ block.settings.text }}
              </div>
            {% endif %}

            {% if block.settings.button_text and block.settings.button_url %}
              <a
                href="{{ block.settings.button_url }}"
                class="btn btn-{{ block.settings.button_style | default: 'primary' }}"
              >
                {{ block.settings.button_text }}
              </a>
            {% endif %}
          </div>
        </div>
    {% endcase %}
  {% endfor %}

  {% if section.blocks.size == 0 %}
    <div class="text-center">
      <h2 class="text-4xl md:text-7xl font-bold text-gray-900 mb-4">Prodotti in evidenza</h2>
      <p class="text-lg text-gray-600 mb-12 max-w-3xl mx-auto">Scopri la nostra selezione di prodotti migliori</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {% for product in collections.all.products limit: 8 %}
          {% render 'card-experience', product: product %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
</section>

{% for block in section.blocks %}
  {% if block.type == 'collection' %}
    {% render 'swiper-config',
      id: 'featured-products-swiper',
      type: 'products',
      slides_per_view: 2.5,
      space_between: 24,
      autoplay: false,
      loop: false,
      pagination: true,
      navigation: true,
      prev_el: '.featured-products-button-prev',
      next_el: '.featured-products-button-next'
    %}
    {% break %}
  {% endif %}
{% endfor %}

{% schema %}
{
  "name": "Featured Products",
  "tag": "section",
  "class": "featured-products",
  "max_blocks": 20,
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Featured Products"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "header",
          "content": "Button Settings"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "outline",
              "label": "Outline"
            }
          ],
          "default": "primary"
        },
        {
          "type": "checkbox",
          "id": "show_arrow",
          "label": "Show arrow icon",
          "default": true
        }
      ]
    },
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "checkbox",
          "id": "show_collection_title",
          "label": "Show collection title",
          "default": false
        },
        {
          "type": "range",
          "id": "products_to_show",
          "label": "Products to show",
          "min": 2,
          "max": 50,
          "step": 1,
          "default": 8
        },
        {
          "type": "range",
          "id": "columns",
          "label": "Columns",
          "min": 2,
          "max": 5,
          "step": 1,
          "default": 4
        },
        {
          "type": "checkbox",
          "id": "show_vendor",
          "label": "Show vendor",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_rating",
          "label": "Show rating",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_view_all",
          "label": "Show 'View all' button",
          "default": true
        }
      ]
    },
    {
      "type": "product_list",
      "name": "Product List",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "product_list",
          "id": "product_list",
          "label": "Products",
          "limit": 25
        },
        {
          "type": "range",
          "id": "columns",
          "label": "Columns",
          "min": 2,
          "max": 5,
          "step": 1,
          "default": 4
        },
        {
          "type": "checkbox",
          "id": "show_vendor",
          "label": "Show vendor",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_rating",
          "label": "Show rating",
          "default": false
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "outline",
              "label": "Outline"
            }
          ],
          "default": "primary"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "image_with_text",
      "name": "Image with text",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "outline",
              "label": "Outline"
            }
          ],
          "default": "primary"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "options": [
            {
              "value": "image_first",
              "label": "Image first"
            },
            {
              "value": "text_first",
              "label": "Text first"
            }
          ],
          "default": "image_first"
        }
      ]
    },
    {
      "type": "spacer",
      "name": "Spacer",
      "settings": [
        {
          "type": "range",
          "id": "height",
          "label": "Height",
          "min": 1,
          "max": 12,
          "step": 1,
          "default": 4,
          "unit": "rem"
        }
      ]
    },
    {
      "type": "divider",
      "name": "Divider"
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
