{% comment %}
  Main Cart Page
{% endcomment %}

<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-16">
  <h1 class="text-4xl md:text-7xl font-bold mb-8">Il mio Carrello</h1>

  {% if cart.item_count > 0 %}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Cart Items -->
      <div class="lg:col-span-2">
        <form action="{{ routes.cart_url }}" method="post" class="space-y-4">
          {% for item in cart.items %}
            <div class="card flex gap-4 p-4">
              <!-- Product Image -->
              <div class="shrink-0">
                {% if item.image %}
                  <img
                    src="{{ item.image | image_url: width: 160 }}"
                    alt="{{ item.image.alt | escape }}"
                    class="w-20 h-20 md:w-32 md:h-32 object-cover rounded-md"
                    loading="lazy"
                  >
                {% else %}
                  <div class="w-20 h-20 md:w-32 md:h-32 bg-gray-100 rounded-md flex items-center justify-center">
                    {% render 'icon', icon: 'image', class: 'size-8 text-gray-400' %}
                  </div>
                {% endif %}
              </div>

              <!-- Product Info -->
              <div class="flex-1 min-w-0">
                <div class="flex justify-between items-start mb-2">
                  <div class="flex-1">
                    <h3 class="text-lg font-semibold text-gray-900 mb-1">
                      <a href="{{ item.url }}" class="hover:text-primary">
                        {{ item.product.title }}
                      </a>
                    </h3>
                    {% if item.variant.title != 'Default Title' %}
                      <p class="text-base text-gray-600 mb-1">{{ item.variant.title }}</p>
                    {% endif %}
                    <span class="badge uppercase">
                      {{ item.product.type }}
                    </span>
                  </div>

                  <!-- Remove Button -->
                  <a
                    href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                    class="p-2 text-red-700 hover:bg-gray-50 rounded-full cursor-pointer"
                    aria-label="Rimuovi {{ item.product.title }}"
                  >
                    {% render 'icon', icon: 'trash' %}
                  </a>
                </div>

                <div class="flex flex-wrap items-center justify-between gap-4 mt-4">
                  <!-- Price -->
                  <div class="text-right">
                    {% if item.original_line_price != item.final_line_price %}
                      <span class="text-base text-gray-500 line-through block">
                        {% render 'price-tag', price: item.original_line_price %}
                      </span>
                    {% endif %}
                    <span class="text-lg font-bold text-gray-900">
                      {% render 'price-tag', price: item.final_line_price %}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}

          <button type="submit" name="update" class="sr-only">Aggiorna carrello</button>
        </form>
      </div>

      <!-- Order Summary -->
      <div class="lg:col-span-1">
        <div class="card">
          <h2 class="text-xl font-bold mb-4">Riepilogo ordine</h2>

          <div class="space-y-3 mb-4 pb-4 border-b border-gray-300">
            <div class="flex justify-between items-center">
              <span class="text-gray-600">Subtotale</span>
              {% render 'price-tag', price: cart.total_price, class: 'font-medium' %}
            </div>

            {% if cart.total_discount > 0 %}
              <div class="flex justify-between items-center text-green-600">
                <span>Sconto</span>
                <span class="font-medium">-{{ cart.total_discount | money }}</span>
              </div>
            {% endif %}
          </div>

          <div class="flex justify-between items-center mb-6">
            <span class="text-lg font-bold">Totale</span>
            {% render 'price-tag', price: cart.total_price, class: 'text-2xl font-bold text-primary' %}
          </div>
          <button
            type="submit"
            name="checkout"
            class="btn btn-primary w-full mb-3"
            onclick="window.location.href='{{ routes.cart_url }}/checkout'"
          >
            Procedi al checkout
          </button>

          <a href="/collections/experience" class="btn btn-outline w-full"> Continua lo shopping </a>
        </div>
      </div>
    </div>
  {% else %}
    <!-- Empty Cart -->
    <div class="text-center py-16">
      <div class="mx-auto w-32 h-32 bg-gray-100 rounded-full flex items-center justify-center mb-6">
        {% render 'icon', icon: 'cart', class: 'size-8 text-gray-400' %}
      </div>
      <h2 class="text-2xl font-bold text-gray-900 mb-3">Il tuo carrello è vuoto</h2>
      <p class="text-gray-600 mb-8">Aggiungi qualche prodotto per iniziare lo shopping!</p>
      <a href="/collections/experience" class="btn btn-primary inline-block"> Scopri le experience </a>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Main Cart",
  "tag": "section",
  "class": "section-main-cart",
  "settings": [
    {
      "type": "header",
      "content": "Cart page settings"
    }
  ]
}
{% endschema %}
