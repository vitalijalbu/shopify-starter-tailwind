{% liquid
  assign collection = collections[section.settings.collection]
  assign programs = shop.metaobjects.programs.values

  # Mesi in italiano
  assign mesi_it = 'Gennaio,Febbraio,Marzo,Aprile,Maggio,Giugno,Luglio,Agosto,Settembre,Ottobre,Novembre,Dicembre' | split: ','

  # Raccogli date uniche da prodotti e programs
  assign dates_string = ''

  # Date dai prodotti
  for product in collection.products
    for variant in product.variants
      if variant.metafields.custom.date
        assign date_str = variant.metafields.custom.date | date: '%Y-%m-%d'
        unless dates_string contains date_str
          assign dates_string = dates_string | append: date_str | append: '||'
        endunless
      endif
    endfor
  endfor

  # Date dai programs
  for program in programs
    if program.date
      assign date_str = program.date | date: '%Y-%m-%d'
      unless dates_string contains date_str
        assign dates_string = dates_string | append: date_str | append: '||'
      endunless
    endif
  endfor

  assign unique_dates = dates_string | split: '||' | compact | sort
%}

<section class="py-12 md:pt-36 md:pb-[216px] {% if section.settings.is_dark %}bg-dark {% endif %}">
  <div class="container">
    <!-- Titolo Sezione -->
    {% if section.settings.section_title != blank %}
      <h2
        class="text-4xl md:text-7xl font-semibold mb-12 text-center mx-auto md:max-w-4xl {% if section.settings.is_dark %}text-white{% else %}text-dark{% endif %}"
        data-scroll="slide-rotate-up"
      >
        {{ section.settings.section_title }}
      </h2>
    {% endif %}
    {% if section.settings.section_subtitle != blank %}
      <p class="text-center mx-auto md:max-w-4xl mb-30 {% if section.settings.is_dark %}text-gray-50{% else %}text-gray-600{% endif %}">
        {{ section.settings.section_subtitle }}
      </p>
    {% endif %}

    {% if unique_dates.size > 0 %}
      <div x-data="{ activeDate: '{{ unique_dates.first }}' }">
        <!-- Date Tabs -->
        <div class="flex flex-wrap justify-center gap-4 mb-36">
          {% for date in unique_dates %}
            {% assign giorno = date | date: '%-d' %}
            {% assign mese_num = date | date: '%-m' | minus: 1 %}
            {% assign anno = date | date: '%Y' %}
            {% assign mese_nome = mesi_it[mese_num] %}
            {% assign giorno_settimana_en = date | date: '%A' %}
            {% assign giorno_settimana = giorno_settimana_en
              | replace: 'Sunday', 'Domenica'
              | replace: 'Monday', 'Lunedì'
              | replace: 'Tuesday', 'Martedì'
              | replace: 'Wednesday', 'Mercoledì'
              | replace: 'Thursday', 'Giovedì'
              | replace: 'Friday', 'Venerdì'
              | replace: 'Saturday', 'Sabato'
            %}

            <button
              @click="activeDate = '{{ date }}'"
              {% if section.settings.is_dark %}
                :class="activeDate === '{{ date }}' ? 'bg-white text-dark' : 'bg-transparent text-white border border-white hover:bg-white/10'"
              {% else %}
                :class="activeDate === '{{ date }}' ? 'bg-dark text-white' : 'bg-white text-dark border border-dark hover:bg-gray-50'"
              {% endif %}
              class="btn px-6 py-2 rounded-lg font-medium transition-colors w-[calc(50%-0.5rem)] md:w-auto"
            >
              {{ giorno_settimana }}
              {{ giorno }}
              {{ mese_nome }}
            </button>
          {% endfor %}
        </div>

        <!-- Eventi per ogni data -->
        {% for date in unique_dates %}
          <div x-show="activeDate === '{{ date }}'" class="space-y-12">
            {% assign has_events = false %}

            {% comment %} Creiamo un array con tutti gli eventi ordinati per ora {% endcomment %}
            {% assign all_events_array = '' %}

            {% comment %} Aggiungi prodotti all'array {% endcomment %}
            {% for product in collection.products %}
              {% for variant in product.variants %}
                {% assign variant_date = variant.metafields.custom.date | date: '%Y-%m-%d' %}
                {% if variant_date == date %}
                  {% assign ora_inizio = variant.metafields.custom.ora_inizio | default: 0 %}
                  {% assign ora_fine = variant.metafields.custom.ora_fine | default: 0 %}
                  {% assign padded_ora = ora_inizio %}
                  {% if ora_inizio < 10 %}
                    {% assign padded_ora = '0' | append: ora_inizio %}
                  {% endif %}

                  {% comment %} Format: ORA::TIPO::PRODUCT_HANDLE::VARIANT_ID::PRICE::TITLE {% endcomment %}
                  {% assign event_string = padded_ora
                    | append: '::product::'
                    | append: product.handle
                    | append: '::'
                    | append: variant.id
                    | append: '::'
                    | append: variant.price
                    | append: '::'
                    | append: product.title
                    | append: '::'
                    | append: ora_inizio
                    | append: '::'
                    | append: ora_fine
                  %}
                  {% assign all_events_array = all_events_array | append: event_string | append: '||' %}
                {% endif %}
              {% endfor %}
            {% endfor %}

            {% comment %} Aggiungi programs all'array {% endcomment %}
            {% for program in programs %}
              {% assign program_date = program.date | date: '%Y-%m-%d' %}
              {% if program_date == date %}
                {% assign ora_inizio = program.ora_inizio | default: 0 %}
                {% assign ora_fine = program.ora_fine | default: 0 %}
                {% assign padded_ora = ora_inizio %}
                {% if ora_inizio < 10 %}
                  {% assign padded_ora = '0' | append: ora_inizio %}
                {% endif %}

                {% comment %} Format: ORA::TIPO::TITLE::CATEGORIA::LOCATION::DESCRIPTION {% endcomment %}
                {% assign event_string = padded_ora
                  | append: '::program::'
                  | append: program.title
                  | append: '::'
                  | append: program.categoria
                  | append: '::'
                  | append: program.location
                  | append: '::'
                  | append: program.description
                  | append: '::'
                  | append: ora_inizio
                  | append: '::'
                  | append: ora_fine
                  | append: '::'
                  | append: program.cta
                  | append: '::'
                  | append: program.cta_url
                %}
                {% assign all_events_array = all_events_array | append: event_string | append: '||' %}
              {% endif %}
            {% endfor %}

            {% comment %} Ordina l'array per ora e renderizza {% endcomment %}
            {% assign sorted_events = all_events_array | split: '||' | compact | sort %}

            {% for event_data in sorted_events %}
              {% assign has_events = true %}
              {% assign event_parts = event_data | split: '::' %}
              {% assign event_type = event_parts[1] %}

              {% if event_type == 'product' %}
                {% assign product_handle = event_parts[2] %}
                {% assign variant_id = event_parts[3] %}
                {% assign price = event_parts[4] %}
                {% assign title = event_parts[5] %}
                {% assign ora_inizio = event_parts[6] %}
                {% assign ora_fine = event_parts[7] %}

                {% comment %} Trova il prodotto e la variante per i dettagli completi {% endcomment %}
                {% assign found_product = null %}
                {% assign found_variant = null %}
                {% for product in collection.products %}
                  {% if product.handle == product_handle %}
                    {% assign found_product = product %}
                    {% for variant in product.variants %}
                      {% assign vid_str = variant.id | append: '' %}
                      {% if vid_str == variant_id %}
                        {% assign found_variant = variant %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                    {% break %}
                  {% endif %}
                {% endfor %}

                {% if found_product and found_variant %}
                  <div class="experience-item md:border-b-0 border-b {% if section.settings.is_dark %}border-zinc-700{% else %}border-zinc-200{% endif %} last:border-b-0 pb-8 mb-8">
                    <div class="flex flex-col md:flex-row gap-6">
                      <!-- Time and Title -->
                      <div class="md:w-1/3 md:border-r {% if section.settings.is_dark %}md:border-zinc-700{% else %}md:border-zinc-200{% endif %}">
                        <p class="text-cyan-400 font-semibold text-3xl md:text-4xl mb-2">
                          {{ ora_inizio | replace: '.', ':' }}
                          {% if ora_fine != '0' and ora_fine != '' %}
                            - {{ ora_fine | replace: '.', ':' }}
                          {% endif %}
                        </p>

                        <h3 class="text-3xl mb-1 font-semibold {% if section.settings.is_dark %}text-white{% else %}text-dark{% endif %}">
                          {{ title }}
                        </h3>
                        <p class="{% if section.settings.is_dark %}text-gray-300{% else %}text-gray-600{% endif %} text-2xl mb-4">
                          {{ price | money }}
                        </p>

                        <a
                          target="_blank"
                          href="{{ found_product.url }}?variant={{ variant_id }}"
                          class="btn btn-secondary"
                        >
                          Vai all'experience
                          {% render 'icon', icon: 'arrow-top-right', class: 'ml-4 size-5' %}
                        </a>
                      </div>

                      <!-- Details -->
                      <div class="lg:w-2/3">
                        <ul class="mb-4 space-y-2">
                          {% if product.tags %}
                            <li class="flex gap-4 items-center">
                              <span class="text-xl {% if section.settings.is_dark %}text-gray-300{% else %}text-gray-600{% endif %}"
                                >Categoria</span
                              >
                              <span class="text-xl {% if section.settings.is_dark %}text-gray-100{% else %}text-gray-500{% endif %}">
                                {{- product.tags | join: ', ' -}}
                              </span>
                            </li>
                          {% endif %}

                          {% if found_product.metafields.custom.location.value %}
                            <li class="flex gap-4 items-center">
                              <span class="text-xl {% if section.settings.is_dark %}text-gray-300{% else %}text-gray-600{% endif %}"
                                >Location</span
                              >
                              <span class="text-xl {% if section.settings.is_dark %}text-gray-100{% else %}text-gray-500{% endif %}">
                                {{- found_product.metafields.custom.location.value -}}
                              </span>
                            </li>
                          {% endif %}

                          {% if found_variant.metafields.custom.livello_difficolta %}
                            <li class="flex gap-4 items-center">
                              <span class="text-xl {% if section.settings.is_dark %}text-gray-300{% else %}text-gray-600{% endif %}"
                                >Livello:</span
                              >
                              <span class="text-xl {% if section.settings.is_dark %}text-gray-100{% else %}text-gray-500{% endif %}">
                                {{- found_variant.metafields.custom.livello_difficolta -}}
                              </span>
                            </li>
                          {% endif %}

                          {% if found_variant.metafields.custom.durata %}
                            <li class="flex gap-4 items-center">
                              <span class="text-xl {% if section.settings.is_dark %}text-gray-300{% else %}text-gray-600{% endif %}"
                                >Durata:</span
                              >
                              <span class="text-xl {% if section.settings.is_dark %}text-gray-100{% else %}text-gray-500{% endif %}">
                                {{- found_variant.metafields.custom.durata -}}
                              </span>
                            </li>
                          {% endif %}

                          {% if found_product.description %}
                            <li class="py-3">
                              <p class="{% if section.settings.is_dark %}text-gray-300{% else %}text-gray-600{% endif %}">
                                Descrizione Completa:
                              </p>
                              <div class="{% if section.settings.is_dark %}text-gray-100{% else %}text-gray-500{% endif %}">
                                {{ found_product.description }}
                              </div>
                            </li>
                          {% endif %}
                        </ul>

                        {% if found_variant.metafields.custom.descrizione %}
                          <div class="pt-2">
                            <span class="text-xl {% if section.settings.is_dark %}text-gray-300{% else %}text-gray-600{% endif %} mb-1"
                              >Descrizione:</span
                            >
                            <span class="text-xl {% if section.settings.is_dark %}text-gray-300{% else %}text-gray-600{% endif %}">
                              {{- found_variant.metafields.custom.descrizione -}}
                            </span>
                          </div>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                {% endif %}

              {% elsif event_type == 'program' %}
                {% assign title = event_parts[2] %}
                {% assign categoria = event_parts[3] %}
                {% assign location = event_parts[4] %}
                {% assign description = event_parts[5] %}
                {% assign ora_inizio = event_parts[6] %}
                {% assign ora_fine = event_parts[7] %}
                {% assign cta = event_parts[8] %}
                {% assign cta_url = event_parts[9] %}

                <div class="experience-item md:border-b-0 border-b {% if section.settings.is_dark %}border-zinc-700{% else %}border-zinc-200{% endif %} last:border-b-0 pb-8 mb-8">
                  <div class="flex flex-col lg:flex-row gap-6">
                    <!-- Time and Title -->
                    <div class="lg:w-1/3 lg:border-r {% if section.settings.is_dark %}lg:border-zinc-700{% else %}lg:border-zinc-200{% endif %}">
                      <p class="text-cyan-400 font-semibold text-3xl md:text-4xl mb-2">
                        {{ ora_inizio | replace: '.', ':' }}
                        {% if ora_fine != '0' and ora_fine != '' %}
                          - {{ ora_fine | replace: '.', ':' }}
                        {% endif %}
                      </p>

                      <h3 class="text-3xl mb-1 font-semibold {% if section.settings.is_dark %}text-white{% else %}text-dark{% endif %}">
                        {{ title }}
                      </h3>
                      {% if cta -%}
                        <a href="{{ cta_url | default: '#' }}" target="blank" class="btn btn-secondary mx-auto text-center">
                          {{- cta -}}
                          <span>{% render 'icon', icon: 'arrow-top-right' %}</span>
                        </a>
                        {% comment %} <span class="text-xl {% if section.settings.is_dark %}text-gray-100{% else %}text-gray-500{% endif %}">
                          {{- cta -}}
                        </span> {% endcomment %}
                      {%- endif %}
                    </div>

                    <!-- Details -->
                    <div class="lg:w-2/3">
                      <ul class="mb-4 space-y-2">
                        {% if categoria != '' and categoria != null %}
                          <li class="flex gap-4 items-center">
                            <span class="text-xl {% if section.settings.is_dark %}text-gray-300{% else %}text-gray-600{% endif %}"
                              >Categoria</span
                            >
                            <span class="text-xl {% if section.settings.is_dark %}text-gray-100{% else %}text-gray-500{% endif %}">
                              {{- categoria -}}
                            </span>
                          </li>
                        {% endif %}

                        {% if location != '' and location != null %}
                          <li class="flex gap-4 items-center">
                            <span class="text-xl {% if section.settings.is_dark %}text-gray-300{% else %}text-gray-600{% endif %}"
                              >Location</span
                            >
                            <span class="text-xl {% if section.settings.is_dark %}text-gray-100{% else %}text-gray-500{% endif %}">
                              {{- location -}}
                            </span>
                          </li>
                        {% endif %}
                      </ul>

                      {% if description != '' and description != null %}
                        <div class="pt-2">
                          <p class="{% if section.settings.is_dark %}text-gray-300{% else %}text-gray-600{% endif %}">
                            Descrizione Completa:
                          </p>
                          <p class="{% if section.settings.is_dark %}text-gray-100{% else %}text-gray-500{% endif %}">
                            {{ description | metafield_tag }}
                          </p>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}

            {% unless has_events %}
              <div class="text-center py-12">
                {% render 'empty-state',
                  title: 'Nessun evento disponibile',
                  subtitle: 'Non ci sono eventi programmati per questa data.',
                  icon: 'calendar'
                %}
              </div>
            {% endunless %}
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="text-center py-12">
        {% render 'empty-state',
          title: 'Nessun evento disponibile',
          subtitle: 'Non ci sono eventi programmati al momento.',
          icon: 'calendar'
        %}
      </div>
    {% endif %}
    {% if section.settings.show_more == true %}
      <div class="text-center pt-36">
        <a href="/pages/programma" class="btn btn-primary mx-auto text-center">
          Guarda il programma completo
          <span>{% render 'icon', icon: 'arrow-top-right' %}</span>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Programma Eventi",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Titolo Sezione"
    },
    {
      "type": "text",
      "id": "section_subtitle",
      "label": "Sottotitolo"
    },
    {
      "type": "checkbox",
      "id": "is_dark",
      "label": "Dark background?"
    },
    {
      "type": "checkbox",
      "id": "show_more",
      "label": "Show more button?"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collezione Eventi"    
    }
  ],
  "presets": [
    {
      "name": "Programma Eventi"
    }
  ]
}
{% endschema %}
