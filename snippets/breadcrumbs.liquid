{% comment %}
  Snippet per Breadcrumb JSON-LD e HTML
  Usage: {% render 'breadcrumbs' %}
{% endcomment %}

{% unless template contains 'index' %}
  {% assign breadcrumbs = '' %}
  {% capture breadcrumb_list %}
    <nav aria-label="Breadcrumb" class="breadcrumbs text-base text-gray-600 mb-4">
      <ol class="flex items-center space-x-2" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="{{ routes.root_url }}" class="hover:text-gray-900 transition-colors" itemprop="item">
            <span itemprop="name">Home</span>
          </a>
          <meta itemprop="position" content="1">
          <span class="mx-2 text-gray-400">/</span>
        </li>
        
        {% if template contains 'collection' and collection %}
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="{{ collection.url }}" class="hover:text-gray-900 transition-colors" itemprop="item">
              <span itemprop="name">{{ collection.title }}</span>
            </a>
            <meta itemprop="position" content="2">
          </li>
        {% elsif template contains 'product' and product %}
          {% if collection %}
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a href="{{ collection.url }}" class="hover:text-gray-900 transition-colors" itemprop="item">
                <span itemprop="name">{{ collection.title }}</span>
              </a>
              <meta itemprop="position" content="2">
              <span class="mx-2 text-gray-400">/</span>
            </li>
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <span itemprop="name">{{ product.title }}</span>
              <meta itemprop="position" content="3">
            </li>
          {% else %}
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <span itemprop="name">{{ product.title }}</span>
              <meta itemprop="position" content="2">
            </li>
          {% endif %}
        {% elsif template contains 'blog' and blog %}
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="{{ blog.url }}" class="hover:text-gray-900 transition-colors" itemprop="item">
              <span itemprop="name">{{ blog.title }}</span>
            </a>
            <meta itemprop="position" content="2">
          </li>
        {% elsif template contains 'article' and article %}
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="{{ blog.url }}" class="hover:text-gray-900 transition-colors" itemprop="item">
              <span itemprop="name">{{ blog.title }}</span>
            </a>
            <meta itemprop="position" content="2">
            <span class="mx-2 text-gray-400">/</span>
          </li>
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span itemprop="name">{{ article.title }}</span>
            <meta itemprop="position" content="3">
          </li>
        {% elsif template contains 'page' and page %}
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span itemprop="name">{{ page.title }}</span>
            <meta itemprop="position" content="2">
          </li>
        {% endif %}
      </ol>
    </nav>
  {% endcapture %}

  {{ breadcrumb_list }}

  <!-- JSON-LD Breadcrumb Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ shop.url | json }}
      }
      {% if template contains 'collection' and collection %}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ request.origin | append: collection.url | json }}
      }
      {% elsif template contains 'product' and product %}
        {% if collection %}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": {{ request.origin | append: collection.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ product.title | json }},
          "item": {{ request.origin | append: product.url | json }}
        }
        {% else %}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ product.title | json }},
          "item": {{ request.origin | append: product.url | json }}
        }
        {% endif %}
      {% elsif template contains 'blog' and blog %}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | json }},
        "item": {{ request.origin | append: blog.url | json }}
      }
      {% elsif template contains 'article' and article %}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | json }},
        "item": {{ request.origin | append: blog.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ article.title | json }},
        "item": {{ request.origin | append: article.url | json }}
      }
      {% elsif template contains 'page' and page %}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ page.title | json }},
        "item": {{ request.origin | append: page.url | json }}
      }
      {% endif %}
    ]
  }
  </script>
{% endunless %}