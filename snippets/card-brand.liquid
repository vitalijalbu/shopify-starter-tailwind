{% comment %}
  Renders a test data card.

  Accepts:
    - data: {object} Shopify data (required)
    - cta_text: {string} CTA button text (optional)

  Usage:
    {% render 'card-brand', data: data, cta_text: 'Vieni a provarli' %}
{% endcomment %}

<div class="bg-gray-200 rounded-xl transition-all duration-200 relative h-full flex flex-col" data-scroll="product-card">
  <!-- Logo Section -->
  <div class="p-4 overflow-hidden bg-white rounded-t-xl shrink-0">
    {% render 'picture', image: data.logo, class: 'w-auto h-[80px] mx-auto' %}
  </div>
  
  <!-- Content Section -->
  <div class="p-6 flex flex-col grow">
    <!-- Tags -->
    {% if data.tags %}
      <div class="flex flex-wrap gap-2 mb-4">
        {% for collection in data.tags.value limit: 3 %}
          <span class="badge">
            {{ collection.title }}
          </span>
        {% endfor %}
        {% if data.tags.value.size > 3 %}
          <span class="badge"> +{{ data.tags.value.size | minus: 3 }} </span>
        {% endif %}
      </div>
    {% endif %}

    <!-- Title -->
    <h3 class="text-3xl font-bold text-gray-900 mb-3">
      {{ data.name }}
    </h3>

    <!-- Description - grows to fill space -->
    <div class="grow mb-4">
      {% if data.description != blank %}
        <p class="text-gray-500 text-base leading-relaxed line-clamp-4">
          {{ data.description | strip_html }}
        </p>
      {% endif %}
    </div>

    <!-- CTA Button - always at bottom -->
    <div class="flex justify-start mt-auto">
      <a
        href="/pages/brands/{{  data.name | handle }}"
        class="inline-flex items-center text-gray-900 font-medium text-base transition-colors duration-200 group border-b border-gray-300 hover:border-primary"
      >
        {{ cta_text | default: 'Vieni a provarli' }}
        {% render 'icon',
          icon: 'arrow-top-right',
          class: 'size-5 ml-2 transition-transform duration-200 group-hover:translate-x-1'
        %}
      </a>
    </div>
  </div>
</div>
