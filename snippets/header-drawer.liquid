<!-- Mobile offcanvas menu -->
<div
  x-show="mobileMenuOpen"
  x-transition:enter="transition ease-out duration-200"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition ease-in duration-200"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  class="fixed inset-0 bg-black/50 z-100 w-full !h-screen lg:hidden"
  style="display: none;"
  @click="closeMobileMenu()"
  @close-mobile-menu.window="closeMobileMenu()"
>
  <div
    x-show="mobileMenuOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="translate-x-full"
    class="fixed top-0 right-0 w-full h-dvh bg-white shadow-sm transform z-50"
    @click.stop
    x-data="mobileMenuTabs()"
    @reset-mobile-tabs.window="resetTabs()"
  >
    <!-- Mobile menu header -->
    <div class="flex items-center justify-between p-4 border-b border-zinc-200">
      <!-- Back button -->
      <button
        x-show="currentLevel > 0"
        @click="goBack()"
        class="btn btn-ghost p-2"
        aria-label="Indietro"
      >
        {% render 'icon', icon: 'chevron-left' %}
      </button>

      <!-- Spacer when no back button -->
      <div x-show="currentLevel === 0" class="w-10"></div>
      <span class="text-lg font-semibold text-gray-900">Menu</span>
      <!-- Close button sempre a destra -->
      <button
        @click="closeMobileMenu()"
        class="btn-close p-2"
        aria-label="Close menu"
      >
        {% render 'icon', icon: 'close' %}
      </button>
    </div>

    <!-- Tab title -->
    <div x-show="currentLevel > 0" class="px-6 py-4 border-b border-zinc-200">
      <h3 class="text-xl font-semibold text-gray-900" x-text="currentMenuTitle"></h3>
    </div>

    <!-- Mobile menu content with horizontal sliding -->
    <div class="flex flex-col h-full justify-between pb-safe overflow-hidden">
      <!-- Tab container -->
      <div class="flex-grow relative overflow-hidden">
        <!-- Main menu (level 0) -->
        <div
          class="absolute inset-0 transition-transform duration-300 ease-out"
          :class="currentLevel === 0 ? 'translate-x-0' : '-translate-x-full'"
        >
          <nav class="px-6 py-6 space-y-2 overflow-y-auto h-full">
            {% for link in linklists[section.settings.menu].links %}
              {% if link.links.size > 0 %}
                <button
                  @click="openSubmenu('{{ link.handle }}', '{{ link.title }}')"
                  class="flex items-center justify-between w-full py-3 text-left text-gray-700 hover:text-primary font-medium text-lg hover:bg-gray-50 rounded-lg transition-colors"
                >
                  <span>{{ link.title }}</span>
                  {% render 'icon', icon: 'chevron-right' %}
                </button>
              {% else %}
                <a
                  href="{{ link.url }}"
                  class="block py-3 text-gray-700 hover:text-primary hover:bg-gray-50 rounded-lg font-medium transition-colors text-lg"
                  @click="$dispatch('close-mobile-menu')"
                >
                  {{ link.title }}
                </a>
              {% endif %}
            {% endfor %}
            {% comment %} Nascondi menu accedi/iscriviti e carrello {% endcomment %}
             {% comment %}
            {% if customer %}
              <a
                href="{{ routes.account_url }}"
                class="flex items-center w-full px-3 py-3 text-gray-700 hover:text-primary hover:bg-gray-50 rounded-lg transition-colors text-lg"
                @click="$dispatch('close-mobile-menu')"
              >
                {% render 'icon', icon: 'account', class: 'size-5 mr-3' %}
                <span>Il mio Account</span>
              </a>
            
            {% else %}
              
              <div class="space-y-2 pt-4 border-t border-zinc-200">
                <a
                  href="{{ routes.account_login_url }}"
                  class="btn btn-outline w-full"
                  @click="$dispatch('close-mobile-menu')"
                >
                  <span>Accedi</span>
                </a>
                <a
                  href="/pages/iscriviti"
                  class="btn btn-primary w-full"
                  @click="$dispatch('close-mobile-menu')"
                >
                  Iscriviti <span class="ml-4">{% render 'icon', icon: 'arrow-top-right' %}</span>
                </a>
              </div>
            {% endif %}
            {% endcomment %}
          </nav>
        </div>

        <!-- Submenus (level 1) -->
        {% for link in linklists[section.settings.menu].links %}
          {% if link.links.size > 0 %}
            <div
              class="absolute inset-0 transition-transform duration-300 ease-out"
              :class="currentLevel === 1 && currentSubmenu === '{{ link.handle }}' ? 'translate-x-0' : 'translate-x-full'"
            >
              <nav class="px-6 py-6 space-y-2 overflow-y-auto h-full">
                {% for child_link in link.links %}
                  <a
                    href="{{ child_link.url }}"
                    class="block py-3 text-gray-700 hover:text-primary hover:bg-gray-50 rounded-lg transition-colors text-lg"
                    @click="$dispatch('close-mobile-menu')"
                  >
                    {{ child_link.title }}
                  </a>
                {% endfor %}
                {% for block in section.blocks %}
                  {% if block.type == 'menu_extra_link' and block.settings.parent_menu == link.title %}
                      <a
                        href="{{ block.settings.link }}"
                        @click="navigationMenuClose()"
                        class="flex items-center gap-2 py-3 text-gray-700 hover:text-primary hover:bg-gray-50 rounded-lg transition-colors text-lg"
                      >
                        {{ block.settings.title }}
                        {% render 'icon', icon: 'arrow-top-right' %}
                      </a>
                  {% endif %}
                {% endfor %}
              </nav>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<script>
  function mobileMenuTabs() {
    return {
      currentLevel: 0,
      currentSubmenu: '',
      currentMenuTitle: '',
      history: [],

      openSubmenu(menuHandle, menuTitle) {
        this.history.push({
          level: this.currentLevel,
          submenu: this.currentSubmenu,
          title: this.currentMenuTitle,
        });

        this.currentLevel = 1;
        this.currentSubmenu = menuHandle;
        this.currentMenuTitle = menuTitle;
      },

      goBack() {
        if (this.history.length > 0) {
          const previousState = this.history.pop();
          this.currentLevel = previousState.level;
          this.currentSubmenu = previousState.submenu;
          this.currentMenuTitle = previousState.title;
        } else {
          this.currentLevel = 0;
          this.currentSubmenu = '';
          this.currentMenuTitle = '';
        }
      },

      // Reset when menu closes
      resetTabs() {
        this.currentLevel = 0;
        this.currentSubmenu = '';
        this.currentMenuTitle = '';
        this.history = [];
      },
    };
  }
</script>
